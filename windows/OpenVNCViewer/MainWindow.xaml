<Window x:Class="OpenVNCViewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenVNCViewer · 中文版" Width="1380" Height="860" MinWidth="960" MinHeight="620" UseLayoutRounding="True" PreviewKeyDown="LocalShortcut">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Opacity" Value="0.7"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="#40808080" BorderThickness="0,0,0,1">
   <WrapPanel VerticalAlignment="Center">
    <ToggleButton x:Name="SidebarToggle" Content="连接列表" IsChecked="True" Checked="ToggleSidebar" Unchecked="ToggleSidebar" Padding="12,6" Margin="0,0,12,0"/>
    <Button x:Name="ConnectButton" Content="连接" Click="Connect"/>
    <Button Content="断开" Click="Disconnect"/>
    <Button x:Name="SettingsButton" Content="设置…" Click="OpenSettings" ToolTip="Ctrl + Alt + Shift + S"/>
    <Button Content="刷新画面" Click="RefreshDesktop"/>
    <Button Content="截图" Click="SaveScreenshot"/>
    <Button Content="发送文本…" Click="SendText"/>
    <Button Content="Ctrl+Alt+Del" Click="SendSecureAttention"/>
    <Button Content="全屏" Click="ToggleFullscreen"/>
    <ComboBox x:Name="QuickScale" Width="145" SelectionChanged="QuickScaleChanged" Margin="6,0,0,0" ToolTip="更多缩放选项请打开设置">
     <ComboBoxItem Content="适应窗口"/><ComboBoxItem Content="原始大小"/><ComboBoxItem Content="自定义缩放"/>
    </ComboBox>
   </WrapPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Padding="12,7" BorderBrush="#40808080" BorderThickness="0,1,0,0">
   <StackPanel>
    <TextBlock x:Name="Status" Text="未连接" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="Performance" Opacity="0.7" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
    <TextBlock x:Name="Notice" Opacity="0.8" TextWrapping="Wrap" Margin="0,3,0,0"/>
   </StackPanel>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="Sidebar" Grid.Column="0" BorderBrush="#40808080" BorderThickness="0,0,1,0" Padding="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <DockPanel Margin="0,0,0,10"><Button Content="新建" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="NewProfile" Margin="0"/><TextBlock Text="我的连接" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <ListBox x:Name="ProfileList" Height="150" SelectionChanged="ProfileSelected" MouseDoubleClick="ProfileDoubleClick">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,5"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Address}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="连接名称" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/><TextBox x:Name="ProfileName" ToolTip="给这台服务器起个名字"/>
     <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Host" TextChanged="EndpointEdited" ToolTip="IP 地址或主机名"/>
     <TextBlock Text="端口" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Port" TextChanged="EndpointEdited" Text="5900"/>
     <TextBlock Text="账号" Style="{StaticResource FieldLabel}"/><TextBox x:Name="User" TextChanged="EndpointEdited"/>
     <TextBlock Text="Mac 填系统账号；普通 VNC 留空。" Opacity="0.65" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
     <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="Password" PasswordChanged="PasswordEdited" Margin="0,4,0,10"/>
     <CheckBox x:Name="SavePassword" Content="使用 Windows 加密保存密码" Unchecked="ForgetSavedPassword" Margin="0,2,0,12"/>
     <WrapPanel><Button Content="保存连接" Click="SaveProfile"/><Button Content="删除" Click="DeleteProfile" Margin="0"/></WrapPanel>
     <TextBlock x:Name="ProfileSummary" Opacity="0.7" TextWrapping="Wrap" Margin="0,14,0,0"/>
     <TextBlock Text="只连接可信服务器。通过不可信网络连接时，请使用 VPN 或 SSH 隧道。" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,18,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>
   <Grid Grid.Column="1" Background="#15171B">
    <ScrollViewer x:Name="DesktopScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" ScrollChanged="ViewportChanged" SizeChanged="ViewportSizeChanged" Focusable="False">
     <Canvas x:Name="Surface" Background="#15171B" Focusable="True" MouseMove="PointerMove" MouseDown="PointerDown" MouseUp="PointerUp" MouseWheel="Wheel" KeyDown="KeyDownRemote" KeyUp="KeyUpRemote" LostKeyboardFocus="ReleaseKeys" ClipToBounds="True">
      <Image x:Name="Desktop" Stretch="Fill" RenderOptions.BitmapScalingMode="LowQuality" IsHitTestVisible="False"/>
     </Canvas>
    </ScrollViewer>
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="30">
     <TextBlock Text="连接你的远程桌面" Foreground="White" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock Text="选择已保存的服务器，或在左侧填写地址后点击连接。" Foreground="#B6BDC9" FontSize="15" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
     <TextBlock Text="可在设置中调整帧率、色深、缩放、键鼠和自动重连。" Foreground="#B6BDC9" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
    </StackPanel>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
