<Window x:Class="OpenVNCViewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenVNCViewer · 中文版" Width="1280" Height="800" MinWidth="800" MinHeight="480" UseLayoutRounding="True">
 <DockPanel>
  <WrapPanel DockPanel.Dock="Top" Margin="12" VerticalAlignment="Center">
   <TextBlock Text="服务器 " VerticalAlignment="Center"/><TextBox x:Name="Host" Width="160" Margin="0,0,10,0" ToolTip="远端 IP 或主机名"/>
   <TextBlock Text="端口 " VerticalAlignment="Center"/><TextBox x:Name="Port" Width="58" Text="5900" Margin="0,0,10,0"/>
   <TextBlock Text="账号 " VerticalAlignment="Center"/><TextBox x:Name="User" Width="100" Margin="0,0,10,0" ToolTip="Mac 系统账号；普通 VNC 留空"/>
   <TextBlock Text="密码 " VerticalAlignment="Center"/><PasswordBox x:Name="Password" Width="110" Margin="0,0,10,0"/>
   <Button x:Name="ConnectButton" Content="连接" Click="Connect" Padding="14,5" Margin="0,0,6,0"/>
   <Button Content="断开" Click="Disconnect" Padding="14,5" Margin="0,0,10,0"/>
   <CheckBox x:Name="ShareClipboard" Content="共享剪贴板" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <CheckBox x:Name="MacKeys" Content="Alt 映射为 Command" IsChecked="True" VerticalAlignment="Center"/>
  </WrapPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="12,6" Text="未连接 · F11 全屏 · 仅连接可信服务器，建议使用 VPN / SSH 隧道"/>
  <Border x:Name="Surface" Background="#15171B" Focusable="True" MouseMove="PointerMove" MouseDown="PointerDown" MouseUp="PointerUp" MouseWheel="Wheel" KeyDown="KeyDownRemote" KeyUp="KeyUpRemote" LostKeyboardFocus="ReleaseKeys" ClipToBounds="True">
   <Image x:Name="Desktop" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" IsHitTestVisible="False"/>
  </Border>
 </DockPanel>
</Window>
